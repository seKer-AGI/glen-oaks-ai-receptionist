# --- Required for the voice pipeline (server-side only, never sent to the browser) ---
OPENAI_API_KEY=

# --- Models / voice (defaults shown) ---
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Natural female voice. Other options: nova, shimmer, sage, alloy, ...
OPENAI_TTS_VOICE=coral

# --- Database: PostgreSQL ---
# Either set the standard libpq variables...
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=dentistDB
# ...or a single URL (overrides the PG* variables; URL-encode special characters in the password).
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/dentistDB

# --- Admin dashboard ---
# Required in production. In development, defaults to "admin" with a console warning.
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie (required in production).
SESSION_SECRET=

# --- Public URL (optional) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
